{
  "name": "tic-tac-toe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run.mjs next dev",
    "build": "node scripts/run.mjs prisma generate && node scripts/run.mjs next build",
    "start": "node scripts/run.mjs next start",
    "lint": "eslint",
    "test": "node scripts/run.mjs vitest run",
    "test:watch": "node scripts/run.mjs vitest",
    "test:e2e": "node scripts/run.mjs playwright test",
    "playwright:install": "playwright install chromium",
    "db:migrate": "node scripts/run.mjs prisma migrate dev",
    "db:push": "node scripts/run.mjs prisma db push",
    "postinstall": "node scripts/run.mjs prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^6.19.3",
    "next": "^15.5.9",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9",
    "eslint-config-next": "^15.5.9",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  }
}
