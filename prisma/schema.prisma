generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String      @id @default(cuid())
  /// PII encrypted (aes-256-gcm) — ใช้ revealUserPii() ก่อนแสดงผล
  name          String?
  /// PII encrypted (aes-256-gcm) — ใช้ revealUserPii() ก่อนแสดงผล
  email         String?
  /// HMAC ของ email สำหรับ lookup / unique (ไม่ใช่ plaintext)
  emailLookup   String?     @unique
  emailVerified DateTime?
  role          String      @default("USER")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  accounts      Account[]
  sessions      Session[]
  games         Game[]
  activeGame    ActiveGame?
  stats         UserStat[]
}

model UserStat {
  id         String @id @default(cuid())
  userId     String
  difficulty String @default("NORMAL")
  score      Int    @default(0)
  wins       Int    @default(0)
  losses     Int    @default(0)
  draws      Int    @default(0)
  winStreak  Int    @default(0)
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, difficulty])
}

model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Game {
  id          String   @id @default(cuid())
  userId      String
  difficulty  String   @default("NORMAL")
  result      String
  scoreChange Int
  bonusScore  Int      @default(0)
  winStreak   Int
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActiveGame {
  id           String   @id @default(cuid())
  userId       String   @unique
  board        String
  status       String   @default("PLAYING")
  difficulty   String   @default("NORMAL")
  playerSymbol String   @default("X")
  botSymbol    String   @default("O")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
